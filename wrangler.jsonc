// Cloudflare Workers config. The Astro adapter adds the entry point and static assets binding at build time.
// Secrets (RESEND_API_KEY) are set in the Cloudflare dashboard or with `wrangler secret put`, never here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prodigy-stdio",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Records Lupo downloads (/lupo/download/), one row each, kept until deleted. The schema is in migrations/; apply it with
  // `npx wrangler d1 migrations apply prodigy-stdio --remote` (or --local). Read the numbers with npm run lupo:downloads.
  "d1_databases": [{ "binding": "DB", "database_name": "prodigy-stdio", "database_id": "23637906-8954-4cda-ac90-4146b1634e59" }]
}
