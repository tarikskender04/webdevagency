// Cloudflare Workers config. The Astro adapter adds the entry point and static assets binding at build time.
// Secrets (RESEND_API_KEY) are set in the Cloudflare dashboard or with `wrangler secret put`, never here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prodigy-stdio",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Counts Lupo downloads (/lupo/download/). The dataset is created on the first write; read it with npm run lupo:downloads.
  "analytics_engine_datasets": [{ "binding": "LUPO_DOWNLOADS", "dataset": "lupo_downloads" }]
}
