# The real HTTPS production origin, without a path or trailing slash.
# Confirmed owned domain. This does not connect DNS or publish the website.
PUBLIC_SITE_URL=https://prodigystdio.com
# Enable only when the brand, content, design, and domain are launch-ready.
PUBLIC_SITE_INDEXABLE=false
# Optional HTTPS booking link. Empty until a real scheduler is available.
PUBLIC_BOOKING_URL=
# Set to true once RESEND_API_KEY is configured on the host: the brief form then offers "Send your brief" (POST /api/enquiry/).
PUBLIC_ENQUIRY_ENABLED=false
