---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Hero } from '../components/Hero';
import { site } from '../config/site';
import { buildAssets } from '../lib/assets';
import Header from '../components/Header.astro';
import StandOut from '../components/StandOut.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
const assets = await buildAssets();
---
<BaseLayout title={`Custom Websites for US Businesses | ${site.name}`}>
  <Header />
  <main id="main" tabindex="-1">
    <Hero assets={assets} />
    <StandOut assets={assets} />
    <Process assets={assets} />
    <Contact />
  </main>
  <Footer />
  <noscript><style>.hero-copy > *, .deck-float, .client-strip { animation: none; } .work-picks { display: none; }</style></noscript>
</BaseLayout>
<script>
  import { initMotion } from '../scripts/motion';
  import { initHeroMotion } from '../scripts/hero-motion';
  import { initWorkDeck } from '../scripts/work-deck';
  initMotion();
  initHeroMotion();
  initWorkDeck();
</script>
