---
import InformationLayout from '../layouts/InformationLayout.astro';
import { site, team } from '../config/site';
const contents = [
  { id: 'studio', title: 'The studio' },
  { id: 'people', title: 'The people' },
  { id: 'work', title: 'Selected work' },
  { id: 'project', title: 'Your project' },
];
---
<InformationLayout title="The studio" eyebrow={`About ${site.name}`} description={site.studio.introduction} contents={contents}>
  <section id="studio" aria-labelledby="studio-heading"><h2 id="studio-heading">What we do</h2><p>{site.studio.focus}</p><p>Our process moves from planning and visual design through development, review and launch. <a href="/#process">See how the work happens.</a></p></section>
  <section id="people" aria-labelledby="people-heading"><h2 id="people-heading">The people</h2><p>{site.founder} is your project contact. Meet the people behind the studio.</p><ul class="studio-team">{team.map(person => <li><strong>{person.name}</strong>{person.role && <span>{person.role}</span>}</li>)}</ul></section>
  <section id="work" aria-labelledby="work-heading"><h2 id="work-heading">Selected work</h2><p>Explore projects for <a href="/work/croche/">Crochê</a>, <a href="/work/una-adventure/">Una Adventure</a>, <a href="/work/tierd/">Tierd</a> and <a href="/work/captured/">Captured</a>.</p></section>
  <section id="project" aria-labelledby="project-heading"><h2 id="project-heading">Start with your brief</h2><p>Tell us about your business, budget and timeline. You can review and download a project brief before choosing how to share it.</p><p><a class="button button-ink" href="/#start">Prepare your brief <span aria-hidden="true">↗</span></a></p></section>
</InformationLayout>
