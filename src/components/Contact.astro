---
import { site } from '../config/site';
import { ContactForm } from './ContactForm';
import { Aurora } from './Aurora';
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || '';
if (bookingUrl && new URL(bookingUrl).protocol !== 'https:') throw new Error('PUBLIC_BOOKING_URL must use HTTPS.');
// Turn on only where RESEND_API_KEY is set: the review then sends the brief to site.email through /api/enquiry/.
const enquiryEndpoint = import.meta.env.PUBLIC_ENQUIRY_ENABLED === 'true' ? '/api/enquiry/' : '';
const steps = [
  { title: 'Tell us a little', description: 'Your business, budget and timeline. Under a minute.' },
  { title: 'Review your brief', description: 'Check the details and save a copy for yourself.' },
  bookingUrl
    ? { title: 'Open the calendar', description: 'Choose and confirm a time with our booking provider. Your brief is not sent automatically.' }
    : enquiryEndpoint
      ? { title: 'Send it to us', description: 'Send your brief from this page. We reply by email.' }
    : site.email
      ? { title: 'Choose to share it', description: 'Open an email draft, add anything else and send it when you are ready.' }
      : { title: 'Keep your copy', description: 'Download your brief. Nothing is sent and no call is booked.' },
];
---
<section class="contact-section" id="start" aria-labelledby="contact-heading">
  <div class="contact-aurora effect-wash"><Aurora client:visible amplitude={1.1} speed={.3} /></div>
  <div class="container contact-grid">
    <div class="contact-copy" data-reveal>
      <p class="eyebrow dotted">Start a project</p><h2 id="contact-heading">Tell us about the business. <em>We'll bring the plan.</em></h2>
      <p class="lead">{bookingUrl ? 'Prepare your project brief, then book a free 30-minute call through our calendar. No commitment.' : enquiryEndpoint ? 'Put your project details in one place, review your brief, then send it to us. Nothing is sent until you choose.' : site.email ? 'Put your project details in one place, then choose to email your brief to us. You review everything before sending.' : 'Put your project details in one place. Review your brief and download a copy to keep. Your details stay in this browser until you choose to share the file.'}</p>
      <div class="contact-host"><span class="host-initials" aria-hidden="true">TS</span><div><span class="eyebrow">Project contact</span><strong>{site.founder}</strong><span>{site.name}</span></div></div>
      <ol class="contact-steps">{steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{step.title}</strong><p>{step.description}</p></div></li>)}</ol>
      {site.email && <p class="email-fallback">Rather write? <a href={`mailto:${site.email}`}>{site.email}</a></p>}
    </div>
    <ContactForm bookingUrl={bookingUrl} email={site.email} enquiryEndpoint={enquiryEndpoint} client:visible />
  </div>
</section>
