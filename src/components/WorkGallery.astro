---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Work, WorkTile } from '../config/work';
import type { Assets } from '../lib/assets';
import { WorkArt } from './WorkArt';
import SwipeHint from './SwipeHint.astro';
interface Props { project: Work; assets: Assets; }
const { project, assets } = Astro.props;
// Sheets and screenshots link to a full-size copy; work-page.ts opens it in the page's lightbox, and without JavaScript the link opens the image.
const sheets = import.meta.glob<{ default: ImageMetadata }>('../assets/work/references/*.png', { eager: true });
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/work/gallery/*.png', { eager: true });
// A tile naming a file that isn't there fails the build with that file's path, rather than a bare TypeError.
const load = (files: Record<string, { default: ImageMetadata }>, path: string): ImageMetadata => {
  const file = files[path];
  if (!file) throw new Error(`WorkGallery: ${path.replace('../', 'src/')} is missing. Add the file or update the gallery in src/config/work.ts.`);
  return file.default;
};
const wide = (tile: WorkTile): boolean => tile.type === 'shot' || tile.type === 'reel';
// 3:4 beside 2986:1734 at equal heights: the wide tile is (4 / 3) × (2986 / 1734) ≈ 2.296 times as wide.
const ratio = 2.296;
const sizes = {
  narrow: '(min-width: 1304px) 370px, (min-width: 761px) 29vw, calc(100vw - 40px)',
  wide: '(min-width: 1304px) 850px, (min-width: 761px) 66vw, calc(100vw - 40px)',
  half: '(min-width: 1304px) 610px, (min-width: 761px) 48vw, calc(100vw - 40px)',
  quarter: '(min-width: 1304px) 300px, (min-width: 1101px) 23vw, (min-width: 761px) 48vw, 50vw',
  trio: '(min-width: 1304px) 400px, (min-width: 761px) 31vw, calc(100vw - 40px)',
};
const rows = await Promise.all(project.gallery.map(async row => {
  const kind = row.length === 3 ? 'trio' : row.length === 1 ? 'single' : 'pair';
  const hasDetails = row.some(tile => tile.type === 'details');
  const tiles = await Promise.all(row.map(async tile => {
    const size = kind === 'trio' ? (hasDetails ? sizes.quarter : sizes.trio) : row.every(wide) ? sizes.half : wide(tile) ? sizes.wide : sizes.narrow;
    if (tile.type === 'sheet') {
      const src = load(sheets, `../assets/work/references/${tile.image}.png`);
      const [preview, full] = await Promise.all([
        getImage({ src, width: 900, widths: [360, 600, 900], format: 'webp', quality: 80 }),
        getImage({ src, width: 1800, format: 'webp', quality: 84 }),
      ]);
      return { tile, size, preview, full };
    }
    if (tile.type === 'shot') {
      const src = load(shots, `../assets/work/gallery/${tile.image}.png`);
      const [preview, full] = await Promise.all([
        getImage({ src, width: 1700, widths: [640, 960, 1280, 1700], format: 'webp', quality: 80 }),
        getImage({ src, width: 2400, format: 'webp', quality: 84 }),
      ]);
      return { tile, size, preview, full };
    }
    if (tile.type === 'reel') {
      const src = load(shots, `../assets/work/gallery/${tile.poster}.png`);
      return { tile, size, preview: await getImage({ src, width: 1600, format: 'webp', quality: 78 }) };
    }
    return { tile, size };
  }));
  // In a row of three, the details take a double column beside two smaller 3:4 tiles.
  const columns = row.map(tile => `minmax(0, ${wide(tile) ? ratio : tile.type === 'details' && kind === 'trio' ? 2 : 1}fr)`).join(' ');
  return { kind, tiles, columns, hasDetails };
}));
// Consecutive rows of pictures form a group. On wider screens the groups vanish (display: contents) and the rows keep their
// grid; on phones each group becomes one swipeable strip, so a project's pictures take one row instead of a long column.
const groups = rows.reduce<{ strip: boolean; rows: typeof rows }[]>((list, row) => {
  const last = list.at(-1);
  if (!row.hasDetails && last?.strip) last.rows.push(row);
  else list.push({ strip: !row.hasDetails, rows: [row] });
  return list;
}, []);
---
<div class="work-gallery">
  {groups.map(group => <div class:list={['work-group', { 'work-group-strip': group.strip }]}>
  <div class:list={['work-group-rows', { 'work-strip': group.strip }]} data-swipe={group.strip ? '' : undefined} role={group.strip ? 'group' : undefined} aria-label={group.strip ? `${project.client} pictures` : undefined}>
  {group.rows.map(row => <div class:list={['work-row', `work-row-${row.kind}`, { 'has-details': row.hasDetails }]} style={row.kind === 'single' ? undefined : `--columns: ${row.columns}`}>
    {row.tiles.map(({ tile, size, preview, full }, index) => {
      // Tiles fade up in turn as their row scrolls into view (work-page.ts).
      const reveal = { 'data-reveal': '', style: `--reveal-delay: ${index * 90}ms` };
      if (tile.type === 'art') return <div class="work-tile work-tile-art project-art work-art" {...reveal} role="img" aria-label={project.description}><WorkArt id={project.id} assets={assets} eager={false} sizes={size} /></div>;
      // The details: a list beside the pictures on wider screens, a strip of cards that swipe one at a time on phones.
      if (tile.type === 'details') return <Fragment>
        <ul class="work-tile work-details" {...reveal} data-swipe aria-label={`${project.client} details`}>{project.details.map((detail, index) => <li class="project-detail"><span class="eyebrow" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{detail.title}</h3><p>{detail.body}</p></div></li>)}</ul>
        <SwipeHint count={project.details.length} />
      </Fragment>;
      if (tile.type === 'reel') return <figure class="work-tile work-tile-reel" {...reveal}>
        <video muted loop playsinline preload="none" poster={preview!.src} width={preview!.attributes.width} height={preview!.attributes.height} aria-label={tile.label}><source src={tile.src} type="video/mp4" /></video>
        <figcaption class="work-tile-label">{tile.caption}</figcaption>
        <button type="button" class="work-reel-toggle" aria-label={`Play ${tile.caption.toLowerCase()}`} data-play={`Play ${tile.caption.toLowerCase()}`} data-pause={`Pause ${tile.caption.toLowerCase()}`}>
          <svg class="icon-play" width="14" height="14" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.6 1.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86L3.36.77a.5.5 0 0 0-.76.43z" fill="currentColor" /></svg>
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 10 10" aria-hidden="true"><rect x="2" y="1.5" width="2.2" height="7" rx=".5" fill="currentColor" /><rect x="5.8" y="1.5" width="2.2" height="7" rx=".5" fill="currentColor" /></svg>
        </button>
      </figure>;
      return <a class={`work-tile work-tile-${tile.type}`} {...reveal} href={full!.src} data-lightbox data-caption={`${project.client} · ${tile.caption}`}>
        <img src={preview!.src} srcset={preview!.srcSet.attribute} sizes={size} width={preview!.attributes.width} height={preview!.attributes.height} alt={tile.alt} loading="lazy" decoding="async" />
        <span class="work-tile-label">{tile.caption}<span aria-hidden="true">↗</span></span>
      </a>;
    })}
  </div>)}
  </div>
  {group.strip && <SwipeHint count={group.rows.reduce((total, row) => total + row.tiles.length, 0)} />}
  </div>)}
</div>
