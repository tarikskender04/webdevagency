---
import { site, legal } from '../config/site';
const home = Astro.url.pathname === '/' ? '' : '/';
const contactLabel = import.meta.env.PUBLIC_BOOKING_URL ? 'Book a free call' : 'Prepare a brief';
---
<footer class="site-footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container footer-inner">
    <div class="footer-top">
      <p>Websites, online ordering and back offices for <em>local</em> businesses.</p>
      <div class="footer-columns">
        <div><h2 class="eyebrow">Site</h2><a href="/about/">Studio</a><a href={`${home}#process`}>Process</a><a href="/lupo/">Lupo</a><a href={`${home}#start`}>Start a project</a></div>
        <div><h2 class="eyebrow">Contact</h2>{site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}<a class="footer-cta" href={`${home}#start`}>{contactLabel} →</a></div>
        {site.socialProfiles.length > 0 && <div><h2 class="eyebrow">Follow</h2>{site.socialProfiles.map(profile => <a href={profile.url} rel="noopener noreferrer" target="_blank">{profile.name}</a>)}</div>}
      </div>
    </div>
    <div class="footer-identity"><p>{site.studio.introduction}</p>{legal.operatorName && <p>Operated by {legal.operatorName}.{legal.contactAddress && <> {legal.contactAddress}</>}</p>}</div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <nav class="footer-legal" aria-label="Legal"><a href="/privacy/">Privacy &amp; Cookies</a><a href="/terms/">Website Terms</a><button type="button" class="footer-cookie-settings" data-cookie-settings>Cookie settings</button></nav>
      <a class="back-to-top" href="#top">Back to top ↑</a>
    </div>
    <div class="footer-wordmark" aria-hidden="true" style={`--footer-logo: url("${site.brandAssets.logo.ink}"); aspect-ratio: ${site.brandAssets.logo.width} / ${site.brandAssets.logo.height}`}></div>
  </div>
</footer>
