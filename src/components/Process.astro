---
import type { Assets } from '../lib/assets';
import { processSteps } from '../config/process';
import { ProcessVisual } from './ProcessVisual';
import { ReviewPanel } from './ReviewPanel';
import { Aurora } from './Aurora';
import { AssetImage } from './AssetImage';
import { Arrow } from './Arrow';
interface Props { assets: Assets; }
const { assets } = Astro.props;
---
<section id="process" class="process-section" aria-labelledby="process-heading">
  <div class="process-aurora effect-wash"><Aurora client:visible amplitude={1.2} speed={.4} /></div>
  <div class="container process-inner">
    <div class="process-heading" data-reveal><p class="eyebrow dotted">How the work happens</p><h2 id="process-heading">From a pencil line to <em>opening day</em></h2><p class="lead">Five steps, in order, every time. Here's what they looked like for Crochê, a one-woman bag studio in Sarajevo, start to finish.</p></div>
    <div class="process-rows">
      <div class="process-spine" aria-hidden="true"><span /></div>
      {processSteps.map((step, index) => <article class={`process-row ${index % 2 ? 'process-row-reverse' : ''}`}>
        <span class="process-dot" aria-hidden="true" />
        <div class="process-copy" data-reveal><span class="section-pill">// {String(index + 1).padStart(2, '0')}</span><h3>{step.title} <em>{step.accent}</em></h3><p>{step.body}</p><ul>{step.points.map(point => <li>{point}</li>)}</ul></div>
        <div class="process-visual" data-reveal>
          {step.kind === 'review' ? <ReviewPanel assets={{ square: assets.square }} client:visible /> : <ProcessVisual assets={assets} kind={step.kind} />}
          <AssetImage asset={assets[index % 2 ? 'triangle' : 'butterfly']} alt="" className="motif process-motif" />
        </div>
      </article>)}
    </div>
    <div class="process-closing" data-reveal><p>At every phase we are fully with you, providing only the <em>best</em>.</p><a href="#start" class="button button-ink">Start a project <span class="button-circle"><Arrow diagonal /></span></a></div>
  </div>
</section>
