---
import { iconPaths, type IconName } from '../lib/icons';
interface Props { name: IconName; size?: number; class?: string; }
const { name, size = 16, class: className } = Astro.props;
---
<svg class:list={['icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d={iconPaths[name]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
