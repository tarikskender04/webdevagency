# Copy to .env.cloudflare for `npm run lupo:downloads`. Never commit the copy (.env.* is gitignored).
# Account ID: Cloudflare dashboard → Account home → ⋯ next to the account name → Copy account ID.
CLOUDFLARE_ACCOUNT_ID=
# API token with one permission, Account → Account Analytics → Read. Read-only: it can't change anything.
CLOUDFLARE_ANALYTICS_TOKEN=
